# local (default) transcribes on this machine with faster-whisper. No key.
# mock skips speech recognition. openai uses the Audio and Chat APIs.
AI_PROVIDER=local
WHISPER_MODEL=small
# Optional. Leave unset to auto-detect. Use id for Indonesian.
# WHISPER_LANGUAGE=

# Required only when AI_PROVIDER=openai. Never put this in client code.
OPENAI_API_KEY=

# Optional OpenAI-compatible HTTPS origin. Private keys stay on the server.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_HIGHLIGHT_MODEL=gpt-4o-mini

# Upload cap for local masters.
MAX_UPLOAD_MB=300

# Optional. Defaults to ./.data
# DATA_DIR=
